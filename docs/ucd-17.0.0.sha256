# UCD 17.0.0 — input manifest for docs/pattern-syntax-audit.py
#
# The generated character tables (clang/lib/Lex/UnicodeOperatorCharSets.h on
# the Unicode branches) are derived from these five files and from nothing
# else. Neither this repo nor the LLVM worktrees carry the files themselves —
# they are ~3.6 MB of upstream data with a stable published home — so this
# manifest is what makes the derivation reproducible: fetch the five URLs
# below, check them against these hashes, and the generator must produce the
# committed header byte for byte.
#
# Fetch the VERSION-PINNED 17.0.0 path, never `latest/`. The token set is a
# frozen enumeration and re-deriving it against a drifting UCD silently
# produces a different set, which is the exact failure mode freezing it exists
# to prevent. `latest/` is 18.0 as of 2026-09.
#
#   base:  https://www.unicode.org/Public/17.0.0/ucd/
#   emoji: https://www.unicode.org/Public/17.0.0/ucd/emoji/
#
# Format is `sha256sum` check format, so both of these work:
#
#   sha256sum -c docs/ucd-17.0.0.sha256          # run inside the UCD dir
#   python3 docs/pattern-syntax-audit.py <ucd-dir> --verify-manifest
#
# The second refuses to derive anything when a hash does not match; the first
# is the same check without the generator. Comment lines are ignored by both.
#
# Publication dates, from each file's own `# Date:` header — UnicodeData.txt
# is the one file that carries no header line, so its hash is the only handle
# on it:
#
#   PropList.txt               2025-06-30, 06:19:01 GMT     145465 bytes
#   DerivedAge.txt             2025-07-30, 23:54:38 GMT     138286 bytes
#   UnicodeData.txt            (no Date header)            2198209 bytes
#   DerivedCoreProperties.txt  2025-07-30, 23:55:08 GMT    1134783 bytes
#   emoji-data.txt             2025-07-25, 17:54:31 GMT     107324 bytes
#
# Recorded 2026-09-06 from a fresh
# fetch, against which the committed header regenerated byte-identically.

# https://www.unicode.org/Public/17.0.0/ucd/PropList.txt
130dcddcaadaf071008bdfce1e7743e04fdfbc910886f017d9f9ac931d8c64dd  PropList.txt
# https://www.unicode.org/Public/17.0.0/ucd/DerivedAge.txt
f8ecdf768bdc210f201abd271d9bc587825618a86a7046a8146cc816393f1998  DerivedAge.txt
# https://www.unicode.org/Public/17.0.0/ucd/UnicodeData.txt
2e1efc1dcb59c575eedf5ccae60f95229f706ee6d031835247d843c11d96470c  UnicodeData.txt
